#!/usr/bin/env bash
# Validate every plugin folder against the Omarchy manifest contract.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"
QMLLINT="${QMLLINT:-}"
failed=0

if [[ -z $QMLLINT ]]; then
  for candidate in qmllint /usr/lib/qt6/bin/qmllint /usr/bin/qmllint6; do
    if command -v "$candidate" >/dev/null 2>&1 || [[ -x $candidate ]]; then
      QMLLINT="$candidate"
      break
    fi
  done
fi

shopt -s nullglob
plugins=("$ROOT"/plugins/*/)
shopt -u nullglob
(( ${#plugins[@]} > 0 )) || { echo "check: no plugins found" >&2; exit 1; }

for dir in "${plugins[@]}"; do
  dir="${dir%/}"
  name="$(basename "$dir")"
  echo "== $name"
  if ! omarchy plugin validate "$dir"; then
    failed=1
    continue
  fi
  if [[ -n $QMLLINT && -d $ROOT/.qml-modules ]]; then
    qml=()
    while IFS= read -r -d '' f; do qml+=("$f"); done < <(find "$dir" -name '*.qml' -print0)
    if (( ${#qml[@]} > 0 )); then
      "$QMLLINT" -I "$ROOT/.qml-modules" "${qml[@]}" || failed=1
    fi
  fi
done

exit "$failed"
